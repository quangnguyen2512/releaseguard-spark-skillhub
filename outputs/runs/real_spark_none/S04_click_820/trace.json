  "release_lines": [
    {
      "line_id": "RN-1",
      "line_num": 4,
      "text": "Breaking: Removed the deprecated `mix_stderr` parameter from `CliRunner.__init__()` in `8.2.0`; read `result.stdout` and `result.stderr` separately."
    },
    {
      "line_id": "RN-2",
      "line_num": 5,
      "text": "Behavior change: `resolve_envvar_value()` now treats an empty environment variable (`\"\"`) as `None` (unset) instead of returning `\"\"`."
    },
    {
      "line_id": "RN-3",
      "line_num": 6,
      "text": "Added Fish `3.7+` completion script templates without changing Bash or Zsh completion output."
    },
    {
      "line_id": "RN-4",
      "line_num": 7,
      "text": "Kept `Context.protected_args` deprecated and scheduled for removal in Click `9.0`."
    }
  ],
  "patch_diff_raw": "diff --git a/cli_kit/options.py b/cli_kit/options.py\nindex 1111111..2222222 100644\n--- a/cli_kit/options.py\n+++ b/cli_kit/options.py\n@@ -1,5 +1,5 @@\n def resolve_envvar_value(env_map, key):\n     raw = env_map.get(key)\n-    if raw is None:\n+    if raw is None or raw == \"\":\n         return None\n     return raw\ndiff --git a/cli_kit/testing_harness.py b/cli_kit/testing_harness.py\nindex 1111111..2222222 100644\n--- a/cli_kit/testing_harness.py\n+++ b/cli_kit/testing_harness.py\n@@ -1,8 +1,7 @@\n class CliRunner:\n-    def __init__(self, charset=\"utf-8\", env=None, mix_stderr=True):\n+    def __init__(self, charset=\"utf-8\", env=None):\n         self.charset = charset\n         self.env = env or {}\n-        self.mix_stderr = mix_stderr\n \n     def run_command(self, cmd_name):\n         return {\"cmd\": cmd_name, \"stdout\": \"ok\", \"stderr\": \"\"}\n",
