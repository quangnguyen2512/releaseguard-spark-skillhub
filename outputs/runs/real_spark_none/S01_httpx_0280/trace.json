{
  "sample_id": "S01_httpx_0280",
  "project": "encode/httpx",
  "from_version": "0.27.2",
  "to_version": "0.28.0",
  "release_url": "https://github.com/encode/httpx/releases/tag/0.28.0",
  "license": "BSD-3-Clause",
  "release_lines": [
    {
      "line_id": "RN-1",
      "line_num": 4,
      "text": "Breaking: Removed the deprecated `proxies=...` parameter from `ClientSession.open_connection()` in `0.28.0`; migrate callers to `proxy=...` for single-URL proxy routing."
    },
    {
      "line_id": "RN-2",
      "line_num": 5,
      "text": "Deprecated boolean/string `verify` shortcuts in `build_ssl_settings(verify=..., cert=...)` in favor of explicit `ssl.SSLContext` instances in `0.28.0`."
    },
    {
      "line_id": "RN-3",
      "line_num": 6,
      "text": "Preserved default connection pool limits (`max_keepalive_connections=20`, `max_connections=100`) unchanged for synchronous HTTP transports."
    },
    {
      "line_id": "RN-4",
      "line_num": 7,
      "text": "Fixed hexadecimal `nonce_count` formatting in `DigestAuth` retry challenges without changing public constructor arguments."
    }
  ],
  "patch_diff_raw": "diff --git a/http_client/config.py b/http_client/config.py\nindex 1111111..2222222 100644\n--- a/http_client/config.py\n+++ b/http_client/config.py\n@@ -2,6 +2,8 @@\n \n \n def build_ssl_settings(verify=True, cert=None):\n+    if isinstance(verify, ssl.SSLContext):\n+        return verify\n     ctx = ssl.create_default_context()\n     if cert is not None:\n         ctx.load_cert_chain(cert)\ndiff --git a/http_client/transport.py b/http_client/transport.py\nindex 1111111..2222222 100644\n--- a/http_client/transport.py\n+++ b/http_client/transport.py\n@@ -5,6 +5,6 @@\n     def __init__(self, timeout=10.0):\n         self.timeout = timeout\n \n-    def open_connection(self, url, proxies=None, ssl_context=None):\n+    def open_connection(self, url, proxy=None, ssl_context=None):\n         ctx = build_ssl_settings(verify=ssl_context)\n-        return {\"url\": url, \"proxies\": proxies, \"ssl_ready\": ctx is not None, \"timeout\": self.timeout}\n+        return {\"url\": url, \"proxy\": proxy, \"ssl_ready\": ctx is not None, \"timeout\": self.timeout}\n",
