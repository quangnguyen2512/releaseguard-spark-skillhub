\":\"billing/ledger_writer.py::append_immutable_entry\",\"via\":\"validation/schema_config.py::compile_model_config\"}],\"tests\":[{\"name\":\"test_export_invoice_json_preserves_tz\",\"covers\":[\"billing/invoice_exporter.py::export_invoice_json\"]},{\"name\":\"test_append_immutable_entry_frozen\",\"covers\":[\"billing/ledger_writer.py::append_immutable_entry\"]}]}\nOutput minified JSON for RN-1..RN-4:\n{\"step0\":{\"schema_version\":\"1.0\",\"mode\":\"diff\",\"target\":{\"path\":\"data/samples/S03_pydantic_2100/repo\",\"tests_dir\":\"data/samples/S03_pydantic_2100/repo/tests\"},\"scope\":{\"diff_file\":\"patch.diff\"},\"confidence\":\"high\",\"clarification_needed\":[]},\"items\":[{\"id\":\"CHK-1\",\"title\":\"concise title\",\"action\":\"concise action\",\"breaking\":true,\"severity\":\"breaking|behavior_change|deprecation|additive\",\"release_note_line_id\":\"RN-1\",\"verbatim_quote\":\"exact 20-55 char substring of RN-1\",\"version_or_flag_tokens\":[\"2.10.0\"],\"uncertainty_note\":null,\"traced_change\":{\"changed_file\":\"file_or_null\",\"changed_symbol\":\"seed_or_null\",\"affected_features\":[\"caller_id\"],\"recommended_tests\":[\"test_name\"]}}]}\nInclude all required source tokens `['v2.10.0', 'allow_mutation', 'frozen=True']` across `version_or_flag_tokens` where mentioned in Notes. If an RN line matches no seed, use `null` and `[]` in `traced_change`."
