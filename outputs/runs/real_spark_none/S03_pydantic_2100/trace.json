  "release_lines": [
    {
      "line_id": "RN-1",
      "line_num": 4,
      "text": "Breaking: Passing `allow_mutation` inside `compile_model_config()` in `v2.10.0` now raises `ValueError(\"allow_mutation is removed; use frozen=True\")` instead of a deprecation warning."
    },
    {
      "line_id": "RN-2",
      "line_num": 5,
      "text": "Behavior change: `dump_audit_record()` now preserves explicit UTC/offset suffixes on timezone-aware ISO-8601 timestamps rather than stripping `+00:00`."
    },
    {
      "line_id": "RN-3",
      "line_num": 6,
      "text": "Added opt-in `experimental_allow_partial=\"trailing-strings\"` streaming flag (disabled by default; no impact on standard validation)."
    },
    {
      "line_id": "RN-4",
      "line_num": 7,
      "text": "Accelerated union schema compilation by `18%` with byte-identical JSON Schema output."
    }
  ],
  "patch_diff_raw": "diff --git a/validation/schema_config.py b/validation/schema_config.py\nindex 1111111..2222222 100644\n--- a/validation/schema_config.py\n+++ b/validation/schema_config.py\n@@ -1,4 +1,4 @@\n def compile_model_config(config_dict):\n     if \"allow_mutation\" in config_dict:\n-        config_dict = {\"frozen\": not config_dict[\"allow_mutation\"]}\n+        raise ValueError(\"allow_mutation is removed; use frozen=True\")\n     return {\"frozen\": bool(config_dict.get(\"frozen\", False)), \"extra\": config_dict.get(\"extra\", \"ignore\")}\ndiff --git a/validation/serializer.py b/validation/serializer.py\nindex 1111111..2222222 100644\n--- a/validation/serializer.py\n+++ b/validation/serializer.py\n@@ -1,2 +1,2 @@\n def dump_audit_record(event_name, iso_timestamp):\n-    return {\"event\": event_name, \"recorded_at\": iso_timestamp.replace(\"+00:00\", \"Z\")}\n+    return {\"event\": event_name, \"recorded_at\": iso_timestamp}\n",
